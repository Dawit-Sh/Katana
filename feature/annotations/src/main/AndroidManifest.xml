<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Save image puts a quote card in Pictures/Katana; Android 10 and later need no permission for it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <!-- Hands a quote card to the app it is shared with. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.quotes"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/quote_paths" />
        </provider>
    </application>

</manifest>
